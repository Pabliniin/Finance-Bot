# Copia este archivo a ".env" y rellena los valores reales.
# NUNCA subas ".env" a un repositorio ni lo compartas. Todo lo sensible vive aqui,
# jamas en config.yaml ni en el codigo.

# --- Base de datos (TimescaleDB, contenedor Docker) ---
POSTGRES_USER=botfinanzas
POSTGRES_PASSWORD=cambia_esto_por_algo_fuerte
POSTGRES_DB=botfinanzas
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Usada dentro de los contenedores (nombre de servicio, no localhost):
DATABASE_URL=postgresql+psycopg2://botfinanzas:cambia_esto_por_algo_fuerte@db:5432/botfinanzas
# Usada por el collector NATIVO en Windows (fuera de Docker, contra el puerto publicado):
DATABASE_URL_HOST=postgresql+psycopg2://botfinanzas:cambia_esto_por_algo_fuerte@localhost:5432/botfinanzas

# --- Discord ---
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALERTS_CHANNEL_ID=
DISCORD_REPORTS_CHANNEL_ID=

# --- MetaTrader5 / XM (solo usado por collector/mt5_live_collector.py, nativo Windows) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=XMGlobal-Demo
MT5_TERMINAL_PATH=

# --- General ---
TZ=UTC
ENVIRONMENT=development
LOG_LEVEL=INFO
