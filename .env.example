# Copia este fichero a .env y rellena SOLO la primera linea para empezar.
# El .env nunca se sube a git (esta en .gitignore). Ninguna clave vive en el codigo.

# 1) OBLIGATORIO. Token del bot: https://discord.com/developers/applications
#    New Application -> Bot -> Reset Token -> copiar aqui.
DISCORD_BOT_TOKEN=

# 2) Opcionales. Si los dejas vacios el bot se ata al servidor donde este al
#    arrancar y publica en el primer canal donde pueda escribir (te lo dice en
#    el log). Rellenalos para fijarlo: clic derecho sobre el servidor o el canal
#    en Discord -> "Copiar ID" (hace falta Ajustes -> Avanzado -> Modo desarrollador).
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=

# 3) Opcional. Quien puede cambiar ajustes (/capital, /modo, /silenciar,
#    /reactivar) y a quien se menciona en las señales. Vacio = cualquiera del
#    servidor. Tu id: clic derecho sobre tu nombre -> "Copiar ID".
DISCORD_ADMIN_USER_IDS=

# 4) MetaTrader 5 (recomendado). Sin esto el bot usa Dukascopy con ~1 h de
#    retraso y bloquea las señales por llegar tarde. Con el terminal abierto y
#    la sesion iniciada normalmente basta con dejarlo vacio.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
